source "https://rubygems.org"

# Matches the gem set GitHub Pages actually builds with, so a local
# `bundle exec jekyll serve` behaves the same as the live site. The
# actions/jekyll-build-pages step in .github/workflows/pages.yml uses
# this same Gemfile to build, so this now doubles as the live build spec
# rather than being local-preview-only.
gem "github-pages", group: :jekyll_plugins

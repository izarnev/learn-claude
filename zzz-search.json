---
layout: null
permalink: /search.json
sitemap: false
---
[
{% assign search_pages = site.pages | where_exp: "p", "p.title" %}
{% assign search_pages = search_pages | where_exp: "p", "p.url != '/404.html'" %}
{% assign search_pages = search_pages | where_exp: "p", "p.url != '/search.json'" %}
{% for p in search_pages %}
  {
    "title": {{ p.title | jsonify }},
    "url": {{ p.url | relative_url | jsonify }},
    "html": {{ p.content | strip_newlines | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]

